# Flask / Preview
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=true
FLASK_DEBUG=false

# IMPORTANT: set a strong secret in non-preview environments
FLASK_SECRET_KEY=change-me

# MySQL (request these from the user/orchestrator)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DB=your_database

# Optional: CORS allow-list (comma-separated) or "*"
ALLOWED_ORIGINS=*

# Optional: upload limit in MB
MAX_UPLOAD_MB=10
