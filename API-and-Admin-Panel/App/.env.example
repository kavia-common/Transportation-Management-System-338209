# Flask / App configuration (example)
# Copy to your environment (or .env if your runtime loads it) and adjust values.

# REQUIRED in production
FLASK_SECRET_KEY=change-me-in-prod

# MySQL connection
MYSQL_HOST=localhost
MYSQL_USER=aquarian
MYSQL_PASSWORD=change-me
MYSQL_DB=aquarian

# File uploads (receipts/images)
# Default (if unset) resolves to: API-and-Admin-Panel/App/App/AdminPanel/static/images/receipts
UPLOAD_FOLDER=/absolute/path/to/receipts
